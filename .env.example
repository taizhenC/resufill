# Copy to .env and fill in. Any OpenAI-compatible endpoint works — the tool only ever
# calls /chat/completions with JSON mode, so switching provider is a two-line change.

# Cerebras
LLM_API_KEY=
LLM_BASE_URL=https://api.cerebras.ai/v1
LLM_MODEL=qwen-3-235b-a22b-instruct

# DeepSeek
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-v4-flash

# Local web UI (`resume-fill serve`). The server reads profile.yaml and spends LLM_API_KEY
# on request, so it refuses to bind anything but loopback unless AUTH_TOKEN is set — and
# then every mutating call must send `Authorization: Bearer <token>`.
HOST=127.0.0.1
PORT=8765
AUTH_TOKEN=

# Blog root for the evidence corpus (`resume-fill blog sync`). The feed is autodetected in
# order: a declared <link rel=alternate>, then a feed at a conventional path, then the
# sitemap, then links off the landing page. Point it at anything.
BLOG_URL=
BLOG_MAX_POSTS=100

# Auto-iterate loop. The score is a local proxy, not anything an employer sees; the loop
# raises it only by surfacing better *existing* evidence, because ground.py blocks invention.
SCORE_THRESHOLD=80
MAX_ITER=4
# By default an honest-but-low ceiling still emits the PDF, with the shortfall stated in
# report.md. Set true to make it a build failure instead.
STRICT_SCORE=false

# Résumé length cap in pages. Overflow is fed back to the tailor as a format violation.
RESUME_MAX_PAGES=1

# Cover letter shape. A letter that runs to two pages does not get read.
COVER_LETTER_MAX_PAGES=1
COVER_LETTER_WORDS=300
COVER_LETTER_TONE=direct and specific; no filler, no flattery, no restating the job ad
# Used when the posting names no addressee — which is almost always. Guessing a name off a
# company page is how a letter ends up addressed to someone who left.
COVER_LETTER_FALLBACK_ADDRESSEE=Hiring Manager

# `linkedin draft` shape. LinkedIn truncates About at ~2,600 characters and collapses it
# after the third line, so the opening paragraph does the work.
LINKEDIN_ABOUT_PARAGRAPHS=3
LINKEDIN_ABOUT_WORDS=180
