# Copy to .env and fill in. Any OpenAI-compatible endpoint works — the tool only ever
# calls /chat/completions with JSON mode, so switching provider is a two-line change.

# Cerebras
LLM_API_KEY=
LLM_BASE_URL=https://api.cerebras.ai/v1
LLM_MODEL=qwen-3-235b-a22b-instruct

# DeepSeek
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-v4-flash

# Blog root for the evidence corpus (`resume-fill blog sync`). RSS/Atom/sitemap is autodetected.
BLOG_URL=

# Auto-iterate loop. The score is a local proxy, not anything an employer sees; the loop
# raises it only by surfacing better *existing* evidence, because ground.py blocks invention.
SCORE_THRESHOLD=80
MAX_ITER=4
# By default an honest-but-low ceiling still emits the PDF, with the shortfall stated in
# report.md. Set true to make it a build failure instead.
STRICT_SCORE=false

# Résumé length cap in pages. Overflow is fed back to the tailor as a format violation.
RESUME_MAX_PAGES=1

# Cover letter shape.
COVER_LETTER_WORDS=300
COVER_LETTER_TONE=direct and specific; no filler, no flattery, no restating the job ad
